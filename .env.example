# Copy to .env and edit.
PORT=4100
# Postgres connection. `npm run db:sync` creates this database if it does not exist
# (the user needs CREATEDB, otherwise create the empty database yourself first).
# DATABASE_URL=   (optional; overrides the DB_* settings below)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_NAME=icrash_analytics
# Either a plain DB_PASS=..., or the AES-256-CBC pair below (needs ENCRYPTION_KEY, 64 hex chars)
# DB_PASS_ENCRYPTED=
# DB_PASS_IV=
# ENCRYPTION_KEY=
# DATABASE_SSL=true

# Initial super admin, created by `npm run db:sync` (only if no account with this email exists).
SUPERADMIN_EMAIL=prasannaj@ithena.ai
SUPERADMIN_PASSWORD=Ithena@1234
SUPERADMIN_NAME=Super Admin

# Set to true when served over HTTPS (marks the session cookie Secure)
COOKIE_SECURE=false
SESSION_DAYS=7
ICRASH_RETENTION_DAYS=30
ICRASH_MAX_EVENTS_PER_ISSUE=100

# --- Email (SMTP, e.g. AWS SES). Used for welcome / password-reset / new-issue alert emails. ---
# SMTP_HOST=email-smtp.us-east-1.amazonaws.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS_ENCRYPTED=     # or plain SMTP_PASS=
# SMTP_PASS_IV=
# SMTP_FROM_EMAIL=
# SMTP_FROM_NAME=iCrash Analytics
# Public URL used in email links
# APP_URL=http://localhost:4100
# ICRASH_ALERTS=true       # set false to disable new-issue alert emails
